POSTGRES_DB=certmuse
POSTGRES_USER=certmuse
POSTGRES_PASSWORD=certmuse_local
POSTGRES_PORT=5432

REDIS_PASSWORD=certmuse_local
REDIS_PORT=6379

MINIO_ROOT_USER=certmuse
MINIO_ROOT_PASSWORD=certmuse_local
MINIO_BUCKET=certmuse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_INTERNAL_ENDPOINT=minio:9000

# Local Docker only: allow learner self-registration after a fresh database seed.
# Set to false when testing the closed-registration flow.
LOCAL_PUBLIC_REGISTRATION=true

BACKEND_PORT=18080
FRONTEND_PORT=3000
JAVA_OPTS=-Xms512m -Xmx1024m

# AI provider (OpenAI-compatible). Keep the real API key only in .env.
CERTMUSE_AI_ENABLED=false
CERTMUSE_AI_BASE_URL=
CERTMUSE_AI_API_KEY=
CERTMUSE_AI_MODEL=
CERTMUSE_AI_CHAT_COMPLETIONS_PATH=/v1/chat/completions

REDIS_IMAGE=redis:8.0.6-alpine@sha256:5f61955be8ab2ccee9372b84ae4d4da2e2b156f87281e3f218544055e7ee04d4
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
