server {
    listen 80;
    server_name cm.jklin.me;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name cm.jklin.me;

    ssl_certificate /etc/nginx/cert/cm.jklin.me.pem;
    ssl_certificate_key /etc/nginx/cert/cm.jklin.me.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /app/certmuse/frontend;
    index index.html;
    client_max_body_size 70m;

    location = /student-index.html {
        internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location = /learning {
        try_files $uri /student-index.html;
    }

    location ^~ /learning/ {
        try_files $uri /student-index.html;
    }

    location ^~ /student-assets/ {
        try_files $uri =404;
    }

    # Standalone practice pages are managed independently from CertMuse's
    # frontend release. Keep them outside /app/certmuse/frontend because the
    # frontend deployment replaces that directory on every release.
    location = /practice {
        return 301 /practice/;
    }

    location ^~ /practice/ {
        alias /app/certmuse-static/practice/;
        index index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Matches web/admin/.env.production VITE_APP_BASE_API.
    location /prod-api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Pre-signed production MinIO URLs use the loopback endpoint. Route them
    # through this HTTPS origin while retaining the signed Host header.
    location ^~ /oss-proxy/127.0.0.1:9000/ {
        rewrite ^/oss-proxy/127\.0\.0\.1:9000/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:9000;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }

    # Internal-only distribution of encrypted srv-ops profile backups.
    # Directory listing remains disabled; individual archives are addressed by name.
    location ^~ /ops-backup/ {
        alias /app/certmuse-backups/srv-ops/;
        autoindex off;
        default_type application/octet-stream;
        add_header Cache-Control "no-store" always;
    }
}
