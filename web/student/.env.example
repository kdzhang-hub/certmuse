# CertMuse 学生端示例配置。复制为 .env.development 或 .env.production 后按环境调整。
VITE_APP_TITLE = CertMuse 学习中心
VITE_APP_LOGO_TITLE = CertMuse 学习中心
VITE_APP_ENV = development
VITE_APP_BASE_API = /dev-api
VITE_APP_ASSET_BASE = /
VITE_APP_CONTEXT_PATH = /
VITE_APP_PORT = 5175
VITE_DEV_PROXY_TARGET = http://localhost:18080
VITE_AUTH_ENTRY_URL = http://localhost:3000/login
VITE_APP_STUDENT_MOCK = true
VITE_APP_ENCRYPT = false
VITE_APP_MESSAGE_ENABLED = false
VITE_APP_MESSAGE_TRANSPORT = sse
VITE_APP_MESSAGE_PATH = /resource/message
